rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Progress docs use anonymous local user IDs — tighten before production.
    match /projects/speech-training/progress/{userId} {
      allow read, write: if true;
    }

  // Assessment submissions — share links for teachers/coaches.
    match /projects/speech-training/submissions/{shareId} {
      allow read, write: if true;
    }
  }
}
