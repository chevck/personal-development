# Copy to .env and fill in from Firebase Console → Project settings → Your apps
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Authentication (required for Speak With Intention)
# Firebase Console → Authentication → Sign-in method → Enable Email/Password
# Deploy firestore.rules and storage.rules after setup

# Optional: support contact shown in password-reset flows and email templates
REACT_APP_SUPPORT_EMAIL=
