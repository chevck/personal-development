rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /speech-training/{userId}/{dayFolder}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /skill_task_submissions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Assessor KYC uploads (profile photo + ID document)—sensitive, so only
    // the assessor themselves can read or write their own files.
    match /assessor_kyc/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
